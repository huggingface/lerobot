{
  "input_root": "/datasets/raw-human-pov",
  "output_root": "/datasets/annotated-human-pov",
  "compute": "rtx-5090",
  "videos_per_group": 8,
  "minimum_segment_frames": 30,
  "backend": {
    "root": "/opt/grounded-data-pipe",
    "python": "/opt/grounded/.venv/bin/python",
    "macrodata_python": "/opt/egovision/.venv/bin/python",
    "droid_root": "/opt/DROID-W",
    "droid_python": "/opt/droid/.venv/bin/python",
    "droid_moge_checkpoint": "/opt/weights/moge-small.pt",
    "droid_model_cache": "/opt/cache/droidw-torch",
    "assets_manifest": "/opt/research-assets.json",
    "assets_sha256": "REPLACE_WITH_SHA256_OF_RESEARCH_ASSETS_JSON",
