# Simulator server images, one per backend, selected with the SIM build argument:
#   docker build -f docker/Dockerfile.sim --build-arg SIM=libero -t lerobot-sim-libero .
# Each `<sim>_native` stage pins its simulator in its own venv; the final stage adds the
# torch-free LeRobot server (`--no-deps` + docker/sims/requirements.txt). BuildKit only builds
# the stages the selected SIM needs.
ARG SIM=libero

# ---------------------------------------------------------------------------- shared base
FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04 AS base
COPY --from=ghcr.io/astral-sh/uv:0.11.30 /uv /uvx /usr/local/bin/
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-venv git build-essential cmake curl unzip ffmpeg \
    libegl1 libgl1 libglx0 libgles2 libglib2.0-0 libosmesa6 libvulkan1 libxrender1 libsm6 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1001 user_lerobot && mkdir /lerobot && chown user_lerobot /lerobot
USER user_lerobot
WORKDIR /lerobot
ENV VIRTUAL_ENV=/home/user_lerobot/venv PATH="/home/user_lerobot/venv/bin:${PATH}" \
    MUJOCO_GL=egl PYOPENGL_PLATFORM=egl NVIDIA_DRIVER_CAPABILITIES=all
RUN uv venv "$VIRTUAL_ENV" --python python3
COPY --chown=user_lerobot:user_lerobot docker/sims/requirements.txt /tmp/sim-requirements.txt
RUN uv pip install -r /tmp/sim-requirements.txt

# ---------------------------------------------------------------------------- LIBERO family
FROM base AS libero_deps
RUN uv pip install --no-deps "hf-libero==0.1.4" \
    && uv pip install "robosuite==1.4.0" "bddl==1.0.1" "easydict==1.13" \
       "hf-egl-probe==1.0.1" "hydra-core>=1.2,<1.4" "mujoco==3.3.1" scipy einops future cloudpickle matplotlib
RUN LIBERO_DIR=$(python -c \
      "import importlib.util, os; s=importlib.util.find_spec('libero'); \
       print(os.path.join(os.path.dirname(s.origin), 'libero'))") && \
    mkdir -p /home/user_lerobot/.libero && \
    python -c "\
from huggingface_hub import snapshot_download; \
snapshot_download(repo_id='lerobot/libero-assets', repo_type='dataset', revision='0b3ea86be5fe169d0fd036ae63d1070ec09e90f6', \
                  local_dir='/home/user_lerobot/.libero/assets')" && \
    printf "assets: /home/user_lerobot/.libero/assets\nbddl_files: ${LIBERO_DIR}/bddl_files\ndatasets: ${LIBERO_DIR}/../datasets\ninit_states: ${LIBERO_DIR}/init_files\n" \
    > /home/user_lerobot/.libero/config.yaml && \
    mkdir -p /home/user_lerobot/.cache/libero && \
    ln -s /home/user_lerobot/.libero/assets /home/user_lerobot/.cache/libero/assets
# The final stage converts LIBERO's torch init states to NumPy; the server rejects missing files.
ENV LEROBOT_SIM_REQUIRE_NUMPY=1

FROM libero_deps AS libero_native

# RoboCerebra runs LIBERO's libero_10 suite with its own camera naming (see its config).
FROM libero_deps AS robocerebra_native

FROM base AS libero_plus_native
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
         unzip libexpat1 libfontconfig1-dev libmagickwand-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
USER user_lerobot
RUN uv pip install --no-cache \
        "robosuite==1.4.1" \
        "bddl==1.0.1" \
        "easydict==1.13" \
        "mujoco==3.7.0" \
        "matplotlib==3.10.8" \
        "Wand==0.6.13" \
        "scikit-image==0.25.2" \
        "gym==0.26.2"
ARG LIBERO_PLUS_SHA=4976dc3
ENV LIBERO_PLUS_ROOT=/home/user_lerobot/libero-plus/libero/libero
# LIBERO-plus ships as a namespace package from a git fork: clone it and put it on PYTHONPATH.
RUN git clone https://github.com/sylvestf/LIBERO-plus.git /home/user_lerobot/libero-plus \
    && git -C /home/user_lerobot/libero-plus checkout ${LIBERO_PLUS_SHA} \
    && cd /home/user_lerobot/libero-plus && uv pip install --no-cache --no-deps -e "." \
    && (uv pip uninstall hf-libero 2>/dev/null || true)
ENV PYTHONPATH="/home/user_lerobot/libero-plus"
RUN python -c "\
from huggingface_hub import hf_hub_download; \
hf_hub_download(repo_id='Sylvest/LIBERO-plus', repo_type='dataset', \
                revision='dd2bd61b7d9a6fef1abc52d606e983b41886a149', filename='assets.zip', local_dir='/tmp/libero-plus-dl')" \
    && unzip -q /tmp/libero-plus-dl/assets.zip -d /tmp/libero-plus-dl/extract \
    && ASSETS_DIR=$(find /tmp/libero-plus-dl/extract -type d -name assets | head -1) \
    && mv "${ASSETS_DIR}" ${LIBERO_PLUS_ROOT}/assets \
    && rm -rf /tmp/libero-plus-dl
RUN mkdir -p /home/user_lerobot/.libero \
    && printf "assets: ${LIBERO_PLUS_ROOT}/assets\nbddl_files: ${LIBERO_PLUS_ROOT}/bddl_files\ndatasets: ${LIBERO_PLUS_ROOT}/../datasets\ninit_states: ${LIBERO_PLUS_ROOT}/init_files\n" \
       > /home/user_lerobot/.libero/config.yaml
ENV LEROBOT_SIM_REQUIRE_NUMPY=1

# ---------------------------------------------------------------------------- MetaWorld
FROM base AS metaworld_native
RUN uv pip install "metaworld==3.0.0"

# ---------------------------------------------------------------------------- EnvHub
# Any EnvHub repository (user/repo[@revision][:env.py]). The launcher passes the repository's optional
# packages.txt (apt, as in Hugging Face Spaces) and requirements.txt as base64 build arguments, so these
# layers are cached by their content: a new commit that only changes env.py rebuilds the last layer.
# Requirements resolve across indexes as pip does. The repository is cached where the Hub loader reads it.
FROM base AS envhub_native
# The repository's files, from the `envhub` build context that `lerobot-env-server --docker --envhub` downloads
# on the host. Each layer is rebuilt only when the files it copies change: apt packages (packages.txt, as in
# Hugging Face Spaces), Python requirements, then the rest of the repository.
USER root
COPY --from=envhub packages.tx[t] /tmp/envhub/
RUN if [ -f /tmp/envhub/packages.txt ]; then apt-get update \
        && xargs -a /tmp/envhub/packages.txt apt-get install -y --no-install-recommends \
        && rm -rf /var/lib/apt/lists/*; fi
USER user_lerobot
COPY --from=envhub requirements.tx[t] /tmp/envhub/
RUN if [ -f /tmp/envhub/requirements.txt ]; then \
        UV_INDEX_STRATEGY=unsafe-best-match uv pip install --no-cache -r /tmp/envhub/requirements.txt; fi
COPY --chown=user_lerobot:user_lerobot --from=envhub . /envhub

# ---------------------------------------------------------------------------- RoboCasa
FROM base AS robocasa_native
ARG ROBOCASA_SHA=56e355ccc64389dfc1b8a61a33b9127b975ba681
ARG ROBOSUITE_SHA=aaa8b9b214ce8e77e82926d677b4d61d55e577ab
# robocasa's setup.py pins lerobot==0.3.3, so it is installed without dependencies.
RUN git clone https://github.com/robocasa/robocasa.git ~/robocasa && \
    git -C ~/robocasa checkout ${ROBOCASA_SHA} && \
    git clone https://github.com/ARISE-Initiative/robosuite.git ~/robosuite && \
    git -C ~/robosuite checkout ${ROBOSUITE_SHA} && \
    uv pip install --no-cache -e ~/robocasa --no-deps && \
    uv pip install --no-cache -e ~/robosuite && \
    uv pip install --no-cache \
      "numpy==2.2.5" "numba==0.61.2" "scipy==1.15.3" "mujoco==3.3.1" \
      "pygame==2.6.1" "Pillow==12.2.0" "opencv-python==4.13.0.92" \
      "pyyaml==6.0.3" "pynput==1.8.1" "tqdm==4.67.3" "termcolor==3.3.0" \
      "imageio==2.37.3" "h5py==3.16.0" "lxml==6.0.4" "hidapi==0.14.0.post4" \
      "gymnasium==1.2.3"
RUN python -m robocasa.scripts.setup_macros && \
    yes y | python -m robocasa.scripts.download_kitchen_assets \
      --type tex tex_generative fixtures_lw objs_lw

# ---------------------------------------------------------------------------- RoboMME
FROM base AS robomme_native
ENV VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
         libvulkan1 libvulkan-dev mesa-vulkan-drivers \
    && mkdir -p /usr/share/vulkan/icd.d \
    && echo '{"file_format_version":"1.0.0","ICD":{"library_path":"libGLX_nvidia.so.0","api_version":"1.3.0"}}' \
       > /usr/share/vulkan/icd.d/nvidia_icd.json \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
USER user_lerobot
# mani-skill (pulled by robomme) pins gymnasium==0.29.1 and numpy<2; it also ships its own torch.
RUN printf 'gymnasium==0.29.1\nnumpy==1.26.4\n' > /tmp/robomme_override.txt \
    && uv pip install --no-cache --override /tmp/robomme_override.txt \
                  "robomme @ git+https://github.com/RoboMME/robomme_benchmark.git@016ac1c4ef3df2b88488abc19db08f3de83647b5" \
    && python -c "import robomme; print('robomme import OK')"

# ---------------------------------------------------------------------------- RoboTwin
FROM base AS robotwin_native
ENV VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json \
    ROBOTWIN_ROOT=/opt/robotwin
USER root
ARG ROBOTWIN_SHA=0aeea2d669c0f8516f4d5785f0aa33ba812c14b4
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
         cuda-nvcc-12-8 cuda-cudart-dev-12-8 \
         libvulkan1 vulkan-tools \
    && mkdir -p /usr/share/vulkan/icd.d \
    && echo '{"file_format_version":"1.0.0","ICD":{"library_path":"libGLX_nvidia.so.0","api_version":"1.3.0"}}' \
       > /usr/share/vulkan/icd.d/nvidia_icd.json \
    && git clone https://github.com/RoboTwin-Platform/RoboTwin.git ${ROBOTWIN_ROOT} \
    && git -C ${ROBOTWIN_ROOT} checkout ${ROBOTWIN_SHA} \
    && chown -R user_lerobot:user_lerobot ${ROBOTWIN_ROOT} \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
USER user_lerobot
# RoboTwin plans with CuRobo and pytorch3d, so this image ships its own torch.
RUN uv pip install "torch==2.7.1" "torchvision==0.22.1" av scipy ninja
RUN uv pip install --no-cache \
        "sapien==3.0.0b1" "mplib==0.2.1" "transforms3d==0.4.2" "trimesh==4.4.3" \
        "open3d==0.19.0" "imageio==2.34.2" termcolor zarr pydantic h5py
RUN uv pip install --no-cache --no-build-isolation \
        "git+https://github.com/facebookresearch/pytorch3d.git@stable"
ARG CUROBO_REF=v0.7.8
RUN cd ${ROBOTWIN_ROOT}/envs \
    && git clone --branch ${CUROBO_REF} --depth 1 https://github.com/NVlabs/curobo.git \
    && cd curobo \
    && TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6;8.9;9.0" \
       uv pip install -e . --no-build-isolation --no-cache
# Upstream fixes RoboTwin relies on: mplib collision check and sapien SRDF loading.
RUN python - <<'EOF'
import pathlib, re, site
for d in site.getsitepackages():
    p = pathlib.Path(d) / "mplib" / "planner.py"
    if p.exists():
        p.write_text(re.sub(r"\bor collide\b", "", p.read_text(), count=1))
        print(f"mplib patch applied: {p}")
    p = pathlib.Path(d) / "sapien" / "wrapper" / "urdf_loader.py"
    if p.exists():
        src = p.read_text().replace(
            "with open(srdf_path) as f:", 'with open(srdf_path, encoding="utf-8") as f:'
        ).replace('"srdf"', '".srdf"')
        p.write_text(src)
        print(f"sapien patch applied: {p}")
EOF
RUN python - <<'EOF'
import os, pathlib, zipfile
from huggingface_hub import hf_hub_download
assets_dir = pathlib.Path(os.environ["ROBOTWIN_ROOT"]) / "assets"
assets_dir.mkdir(parents=True, exist_ok=True)
for fname in ("embodiments.zip", "objects.zip"):
    local = hf_hub_download(
        repo_id="TianxingChen/RoboTwin2.0",
        repo_type="dataset",
        revision="3dc3b798668feb99ac61cc9086d84cbcc3d79186",
        filename=fname,
        local_dir=str(assets_dir),
    )
    with zipfile.ZipFile(local, "r") as z:
        z.extractall(str(assets_dir))
    pathlib.Path(local).unlink()
EOF
WORKDIR ${ROBOTWIN_ROOT}
RUN python script/update_embodiment_config_path.py
ENV PYTHONPATH="${ROBOTWIN_ROOT}"
RUN python - <<'EOF'
from pathlib import Path
from curobo.types.math import Pose
planner_src = (Path("/opt/robotwin/envs/robot/planner.py")).read_text()
assert "from curobo.types.math import Pose as CuroboPose" in planner_src
print("CuRobo import OK:", Pose.__name__)
EOF

# ---------------------------------------------------------------------------- VLABench
FROM base AS vlabench_native
ARG VLABENCH_SHA=cf588fe60c0c7282174fe979f5913170cfe69017
ARG RRT_ALGORITHMS_SHA=e51d95ee489a225220d6ae2a764c4111f6ba7d85
# constant.py lists asset subdirectories at import time; tolerate them being absent.
RUN git clone https://github.com/OpenMOSS/VLABench.git ~/VLABench && \
    git -C ~/VLABench checkout ${VLABENCH_SHA} && \
    git clone https://github.com/motion-planning/rrt-algorithms.git ~/rrt-algorithms && \
    git -C ~/rrt-algorithms checkout ${RRT_ALGORITHMS_SHA} && \
    python3 -c "\
import pathlib; \
p = pathlib.Path.home() / 'VLABench/VLABench/configs/constant.py'; \
t = p.read_text(); \
p.write_text(t.replace( \
    'subdirs = os.listdir(xml_dir)', \
    'if not os.path.isdir(xml_dir): return []\n    subdirs = os.listdir(xml_dir)'))" && \
    uv pip install --no-cache -e ~/VLABench -e ~/rrt-algorithms \
      mujoco==3.2.2 dm-control==1.0.22 \
      open3d colorlog scikit-learn openai gdown
ARG VLABENCH_ASSETS_REPO=""
RUN ASSETS_DIR="$HOME/VLABench/VLABench/assets" && \
    if [ -n "${VLABENCH_ASSETS_REPO}" ]; then \
        echo "Downloading VLABench assets from HF Hub: ${VLABENCH_ASSETS_REPO}" && \
        uv pip install --no-cache "huggingface_hub[hf_xet]>=0.26" && \
        python -c "from huggingface_hub import snapshot_download; \
p = snapshot_download(repo_id='${VLABENCH_ASSETS_REPO}', repo_type='dataset', revision='08d7a4479a55c8fbb89ac0fd6fcf06e53d65b4a4', \
    local_dir='${ASSETS_DIR}', allow_patterns=['obj/**', 'scenes/**']); \
print('snapshot_download returned:', p)"; \
    else \
        echo "No VLABENCH_ASSETS_REPO set — falling back to gdown" && \
        python ~/VLABench/scripts/download_assets.py --choice all; \
    fi && \
    python -c "\
from pathlib import Path; \
import sys; \
root = Path('${ASSETS_DIR}'); \
checks = ['obj/meshes/tablewares/plates', 'obj/meshes/containers/basket', 'obj/meshes/fruit', 'obj/meshes/containers/tray']; \
failed = []; \
print(f'Validating VLABench assets under {root}'); \
[print(f'  {c}: {len(list((root/c).rglob(\"*.xml\")))} XMLs') for c in checks]; \
[failed.append(c) for c in checks if not any((root/c).rglob('*.xml'))]; \
sys.exit(f'Empty asset dirs (no *.xml): {failed}') if failed else print('All asset dirs populated.')"

# ---------------------------------------------------------------------------- LeRobot server
FROM ${SIM}_native AS final
ARG SIM
ENV SIM=${SIM}
WORKDIR /lerobot
COPY --chown=user_lerobot:user_lerobot pyproject.toml setup.py README.md MANIFEST.in /lerobot/
COPY --chown=user_lerobot:user_lerobot src/lerobot/__init__.py src/lerobot/__version__.py /lerobot/src/lerobot/
COPY --chown=user_lerobot:user_lerobot src/lerobot/env_server /lerobot/src/lerobot/env_server
COPY --chown=user_lerobot:user_lerobot src/lerobot/sims /lerobot/src/lerobot/sims
COPY --chown=user_lerobot:user_lerobot src/lerobot/transport /lerobot/src/lerobot/transport
COPY --chown=user_lerobot:user_lerobot src/lerobot/utils /lerobot/src/lerobot/utils
COPY --chown=user_lerobot:user_lerobot src/lerobot/scripts/lerobot_env_server.py /lerobot/src/lerobot/scripts/
COPY --chown=user_lerobot:user_lerobot scripts/ci/convert_sim_assets.py scripts/ci/patch_sim_runtime.py scripts/ci/check_sim_parity.py /lerobot/scripts/ci/
COPY --chown=user_lerobot:user_lerobot docker/sims /lerobot/docker/sims
RUN uv pip install --no-cache --no-deps -e .
# LIBERO family: convert trusted torch init states to NumPy with a temporary CPU torch.
RUN case "${SIM}" in libero|robocerebra|libero_plus) \
        uv pip install "torch==2.14.1" --index-url https://download.pytorch.org/whl/cpu \
        && python scripts/ci/convert_sim_assets.py /home/user_lerobot \
        && python scripts/ci/patch_sim_runtime.py /home/user_lerobot \
        && uv pip uninstall torch torchvision ;; \
    esac
# The server must import without torch, except in images whose simulator ships its own.
RUN case "${SIM}" in \
        libero|robocerebra|libero_plus) module=libero ;; \
        robomme|robotwin) module= ;; \
        *) module=${SIM} ;; \
    esac \
    && if [ -n "$module" ]; then python -c "import sys; sys.modules['torch'] = None; \
import lerobot.env_server.server; import lerobot.sims.native.$module"; fi
CMD ["sh", "-c", "exec lerobot-env-server --config /lerobot/docker/sims/configs/${SIM}.yaml"]
