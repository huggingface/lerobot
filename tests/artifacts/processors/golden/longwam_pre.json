{
  "name": "policy_preprocessor",
  "steps": [
    {
      "config": {
        "rename_map": {}
      },
      "registry_name": "rename_observations_processor"
    },
    {
      "config": {},
      "registry_name": "to_batch_processor"
    },
    {
      "config": {
        "eps": 1e-08,
        "features": {
          "action": {
            "shape": [
              6
            ],
            "type": "ACTION"
          },
          "observation.image.cam": {
            "shape": [
              3,
              96,
              96
            ],
            "type": "VISUAL"
          },
          "observation.images.cam": {
            "shape": [
              3,
              96,
              96
            ],
            "type": "VISUAL"
          },
          "observation.state": {
            "shape": [
              6
            ],
            "type": "STATE"
          }
        },
        "norm_map": {
          "ACTION": "MIN_MAX",
          "STATE": "MIN_MAX",
          "VISUAL": "IDENTITY"
        }
      },
      "registry_name": "normalizer_processor",
      "state_file": "policy_preprocessor_step_2_normalizer_processor.safetensors"
    },
    {
      "config": {
        "camera_keys": [
          "observation.images.image",
          "observation.images.wrist_image"
        ],
        "camera_size": [
          224,
          224
        ],
        "image_dtype": "bfloat16"
      },
      "registry_name": "longwam_observations"
    },
    {
      "config": {},
      "registry_name": "longwam_action_clamp"
    },
    {
      "config": {
        "prompt_template": "A video recorded from a robot's point of view executing the following instruction: {task}"
      },
      "registry_name": "longwam_prompt"
    },
    {
      "config": {
        "max_length": 128,
        "padding": "max_length",
        "padding_side": "right",
        "task_key": "task",
        "tokenizer_name": "google/umt5-xxl",
        "truncation": true
      },
      "registry_name": "tokenizer_processor"
    },
    {
      "config": {
        "device": "cpu",
        "float_dtype": null
      },
      "registry_name": "device_processor"
    }
  ]
}
