{
  "name": "policy_preprocessor",
  "steps": [
    {
      "config": {
        "rename_map": {}
      },
      "registry_name": "rename_observations_processor"
    },
    {
      "config": {},
      "registry_name": "to_batch_processor"
    },
    {
      "config": {
        "device": "cpu",
        "float_dtype": null
      },
      "registry_name": "device_processor"
    },
    {
      "config": {
        "eps": 1e-08,
        "features": {
          "action": {
            "shape": [
              6
            ],
            "type": "ACTION"
          },
          "observation.image.cam": {
            "shape": [
              3,
              96,
              96
            ],
            "type": "VISUAL"
          },
          "observation.images.cam": {
            "shape": [
              3,
              96,
              96
            ],
            "type": "VISUAL"
          }
        },
        "norm_map": {
          "ACTION": "MIN_MAX",
          "STATE": "MIN_MAX",
          "VISUAL": "IDENTITY"
        }
      },
      "registry_name": "normalizer_processor",
      "state_file": "policy_preprocessor_step_3_normalizer_processor.safetensors"
    },
    {
      "config": {
        "image_features": [
          "observation.image.cam",
          "observation.images.cam"
        ],
        "image_hw": [
          256,
          256
        ]
      },
      "registry_name": "lawam_resize_images"
    },
    {
      "config": {
        "act_queries": 8,
        "cot_prompt_after_wrist": "Then use observations and the inferred motion to produce the robot policy actions.",
        "cot_prompt_before_wrist": "Your task is {instruction}.\n\nFrom main-view observations, infer the robot arm's motion.",
        "default_task": "Execute the robot action.",
        "flow_queries": 8,
        "image_hw": [
          256,
          256
        ],
        "model_id": "Qwen/Qwen3-VL-2B-Instruct",
        "placeholder_token": "<ACT_PH>",
        "primary_image_features": [
          "observation.image.cam",
          "observation.images.cam"
        ],
        "wrist_image_features": []
      },
      "registry_name": "lawam_qwen_inputs"
    },
    {
      "config": {
        "action_dim": 32,
        "action_horizon": 8,
        "action_hz": 30.0,
        "chunk_size": 50,
        "embodiment_id": 25,
        "image_hw": [
          256,
          256
        ],
        "lam_image_feature": "observation.image.cam",
        "state_dim": 32,
        "use_state": false
      },
      "registry_name": "lawam_prepare_batch"
    }
  ]
}
